{
    "name": "@mat3ra/eslint-config",
    "version": "1.0.0",
    "description": "Eslint configuration extension to be reused across mat3ra projects.",
    "scripts": {
        "test": "npm run lint",
        "lint": "eslint . && prettier --write .",
        "lint:fix": "eslint --fix --cache . && prettier --write .",
        "prettier": "prettier --check .",
        "prepare": "husky install"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/eslint-config.git"
    },
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./json": "./eslint_config/json.js"
    },
    "files": [
        "index.js",
        "eslint_config/base.js",
        "eslint_config/json.js",
        ".prettierrc"
    ],
    "author": "Exabyte Inc. (Mat3ra.com)",
    "bugs": {
        "url": "https://github.com/mat3ra/eslint-config/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/mat3ra/eslint-config",
    "devDependencies": {
        "@babel/eslint-parser": "^7.29.7",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/register": "^7.29.7",
        "@babel/runtime-corejs3": "^7.29.7",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-import-resolver-exports": "^1.0.0-beta.5",
        "eslint-import-resolver-meteor": "^0.4.0",
        "eslint-import-resolver-node": "^0.3.10 || ^0.4.0",
        "eslint-import-resolver-typescript": "^3.10.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^37.9.7 || ^50.8.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-jsonc": "^2.21.1",
        "eslint-plugin-mui-path-imports": "0.0.15",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "husky": "^7.0.4",
        "jsonc-eslint-parser": "^2.4.2",
        "lint-staged": "^12.5.0",
        "mocha": "^9.2.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@babel/eslint-parser": "^7.29.7",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/register": "^7.29.7",
        "@babel/runtime-corejs3": "^7.29.7",
        "@typescript-eslint/parser": "^5.62.0",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "eslint": "^7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-import-resolver-exports": "^1.0.0-beta.5",
        "eslint-import-resolver-meteor": "^0.4.0",
        "eslint-import-resolver-node": "^0.3.10 || ^0.4.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^37.9.7 || ^50.8.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-jsonc": "^2.21.1",
        "eslint-plugin-mui-path-imports": "^0.0.15",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "jsonc-eslint-parser": "^2.4.2"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,css}": "prettier --write"
    }
}
